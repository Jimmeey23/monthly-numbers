{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f pnpm-lock.yaml yarn.lock'",
    "dev": "concurrently -k -n api,dashboard -c cyan,magenta \"npm run dev:api\" \"npm run dev:dashboard\"",
    "dev:api": "PORT=${API_PORT:-3001} npm run dev --workspace=@workspace/api-server",
    "dev:dashboard": "PORT=${DASHBOARD_PORT:-5173} BASE_PATH=${BASE_PATH:-/} npm run dev --workspace=@workspace/dashboard",
    "build": "npm run typecheck && npm run build --workspaces --if-present",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspaces --if-present"
  },
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "private": true,
  "devDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.62.2",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.2",
    "concurrently": "^9.2.1",
    "lightningcss-darwin-arm64": "^1.32.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@esbuild-kit/esm-loader": "npm:tsx@^4.21.0",
    "esbuild": "0.27.3"
  }
}
